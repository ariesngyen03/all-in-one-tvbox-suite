<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AllInOne_TVBox_Suite</AssemblyName>
    <RootNamespace>AllInOne_TVBox_Suite</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\Decompiled_System\Resources\app.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Decompiled_System\Resources\adb.exe" LogicalName="adb.exe" />
    <EmbeddedResource Include="..\Decompiled_System\Resources\fastboot.exe" LogicalName="fastboot.exe" />
    <EmbeddedResource Include="..\Decompiled_System\Resources\adnl.exe" LogicalName="adnl.exe" />
    <EmbeddedResource Include="..\Decompiled_System\Resources\AdbWinApi.dll" LogicalName="AdbWinApi.dll" />
    <EmbeddedResource Include="..\Decompiled_System\Resources\AdbWinUsbApi.dll" LogicalName="AdbWinUsbApi.dll" />
    <EmbeddedResource Include="..\Decompiled_System\Resources\Amldbglog.dll" LogicalName="Amldbglog.dll" />
    <EmbeddedResource Include="..\Decompiled_System\Resources\AmlLibusb.dll" LogicalName="AmlLibusb.dll" />
    <EmbeddedResource Include="..\Decompiled_System\Resources\AmlUsbScanX3.dll" LogicalName="AmlUsbScanX3.dll" />
    <EmbeddedResource Include="..\Decompiled_System\Resources\libwinpthread-1.dll" LogicalName="libwinpthread-1.dll" />
    <EmbeddedResource Include="..\Decompiled_System\Resources\dv9135.apk" LogicalName="dv9135.apk" />
    <EmbeddedResource Include="..\Decompiled_System\Resources\DVT_DV9135_EnvHelper.apk" LogicalName="DVT_DV9135_EnvHelper.apk" />
    <EmbeddedResource Include="..\Decompiled_System\Resources\app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
